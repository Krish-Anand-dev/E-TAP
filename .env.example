# Copy this file to .env for local development. Never commit .env or real secrets.

# MongoDB
# Local MongoDB Server:
MONGODB_URI=mongodb://localhost:27017/etap
MONGO_DB_NAME=etap
# Set to 1 only for temporary local smoke tests (data is lost on restart).
USE_FAKE_DB=0
AUTO_FALLBACK_DB=0

# Live provider integrations are enabled locally. Add your own keys below.
THREAT_INTEL_LIVE=1
# Maximum outbound indicators queried per provider per email (clamped 1–20).
THREAT_INTEL_MAX_LOOKUPS_PER_PROVIDER=2
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional Gemini analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Bounds each Gemini network request (1000–60000 ms; default 15000).
GEMINI_REQUEST_TIMEOUT_MS=15000

# CORS: comma-separated exact frontend origins; do not use * in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Used by hosting platforms; local backend defaults to 5000.
PORT=5000

# --- Sandbox (VirtualBox) ---
# 'virtualbox' for live detonation, 'replay' for recorded traces, 'none' to disable.
SANDBOX_BACKEND=none
# VBOXMANAGE_PATH=C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
# SANDBOX_VM_NAME=win 11
# SANDBOX_SNAPSHOT=clean
# SANDBOX_GUEST_USER=sandbox
# SANDBOX_GUEST_PASSWORD=
# SANDBOX_DWELL_SECONDS=30
# Optional paths: relative values resolve from the repository root, regardless of cwd.
# SANDBOX_WORK_DIR=backend/sandbox/work
# SANDBOX_RULES_DIR=backend/sandbox/rules
