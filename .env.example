# Copy this file to .env for local development. Never commit .env or real secrets.

# MongoDB
# Local MongoDB Server:
MONGODB_URI=mongodb://localhost:27017/etap
MONGO_DB_NAME=etap
# Set to 1 only for temporary local smoke tests (data is lost on restart).
USE_FAKE_DB=0
AUTO_FALLBACK_DB=0

# External lookups. Keep disabled until keys/privacy behavior are verified.
THREAT_INTEL_LIVE=0
# Maximum outbound indicators queried per provider per email (clamped 1–20).
THREAT_INTEL_MAX_LOOKUPS_PER_PROVIDER=2
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional Gemini analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Bounds each Gemini network request (1000–60000 ms; default 15000).
GEMINI_REQUEST_TIMEOUT_MS=15000

# CORS: comma-separated exact frontend origins; do not use * in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Used by hosting platforms; local backend defaults to 5000.
PORT=5000


# Deeper attachment analysis (optional). agent = the user's own VirtualBox VM through the
# paired E-TAP Sandbox Agent (default); none = off; virtualbox = a VM on this same computer.
# SANDBOX_BACKEND=agent
# Agent jobs: how long a request waits for the agent / may run without a result (seconds).
# SANDBOX_AGENT_JOB_TTL_SECONDS=1800
# SANDBOX_AGENT_RUN_TIMEOUT_SECONDS=900
# Only for SANDBOX_BACKEND=virtualbox (the agent keeps its own copy of these, protected by Windows):
# SANDBOX_VM_NAME=
# SANDBOX_SNAPSHOT=clean
# SANDBOX_GUEST_USER=
# SANDBOX_GUEST_PASSWORD=
